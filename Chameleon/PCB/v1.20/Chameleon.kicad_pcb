	(gr_text "BOOT"
		(at 82.288072 80.73 0)
		(layer "B.SilkS")
		(uuid "154aeac1-e38e-4fb9-ae81-fe01d1b50b1a")
		(effects
			(font
				(size 1 1)
				(thickness 0.153)
			)
			(justify left bottom mirror)
		)
	)
	(gr_text "RESET"
		(at 44.521405 80.75 0)
		(layer "B.SilkS")
		(uuid "6f512a18-0905-4228-aa0e-83e62a5c3cf3")
		(effects
			(font
				(size 1 1)
				(thickness 0.153)
				(bold yes)
			)
			(justify left bottom mirror)
		)
	)
	(gr_text "The Chameleon PCB supports a 5x12 or 4x12 matrix with 8 RGB LEDs for under-glow and one encoder per corner. \nEach layout supports a full matrix, a single 2u or two 2u keys on the bottom row. Please note that 2u keys and stabilizers should only be installed at the CURRENT bottom row."
		(at 164.8 61.07 0)
		(layer "B.SilkS")
		(uuid "b443b067-0261-4638-baa9-7f1b5b92c872")
		(effects
			(font
				(size 1 1)
				(thickness 0.153)
			)
			(justify bottom mirror)
		)
	)
	(gr_text "The bottom corner encoders connect in parallel to the same input, and only ONE encoder per corner is functional at each time. Please do NOT install encoders in both rows!\nThe optional placements for RGB LEDs are parallel, and only ONE bottom row is functional at each time. Please do NOT install LEDs in both bottom rows!\n"
		(at 164.8 80.35 0)
		(layer "B.SilkS")
		(uuid "b8ca6958-49b3-49c5-a9bf-0c6df9bf720e")
		(effects
			(font
				(size 1 1)
				(thickness 0.153)
			)
			(justify bottom mirror)
		)
	)
	(gr_text "To use the 4x12 layout, break away the bottom row. First, use an exacto knife or a small rotary tool to score the tabs for a clean break. File off any remaining sharp edges."
		(at 164.8 99.16 0)
		(layer "B.SilkS")
		(uuid "e5c25a40-8c7c-4982-a508-020caf7d6c01")
		(effects
			(font
				(size 1 1)
				(thickness 0.153)
			)
			(justify bottom mirror)
		)
	)
	(gr_text "Chameleon - v1.11 - Markus Knutsson 2024\nhttps://github.com/TweetyDaBird"
